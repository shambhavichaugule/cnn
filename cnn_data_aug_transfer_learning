    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(y_test, aug_pred, target_names=classes))\n",
    "\n",
    "# Save model\n",
    "torch.save(model_aug.state_dict(), 'cnn_augmented.pth')\n",
    "print(\"\\nAugmented model saved!\")"
